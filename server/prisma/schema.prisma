generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id            Int      @id @default(autoincrement())
  customerName  String
  email         String
  phone         String
  service       String
  amount        Int
  paymentStatus String   @default("PENDING")
  createdAt     DateTime @default(now())
}